# Electronics prices
data <- c(
  1, 1, 5, 5, 5, 5, 8, 8, 10, 10, 10,
  12, 14, 14, 14, 15, 15, 15, 15, 18,
  18, 18, 18, 18, 20, 20, 20, 20, 20,
  21, 21, 21, 21, 25, 25, 25, 25, 25,
  28, 28, 30
)
# Equal-frequency bins of size 3
bins <- split(data, ceiling(seq_along(data) / 3))
print(bins)
# Bin mean smoothing
bin_means <- sapply(bins, mean)
smoothed_mean <- unlist(
  lapply(bins, function(x) rep(mean(x), length(x)))
)
# Bin boundary smoothing
smoothed_boundary <- unlist(
  lapply(bins, function(x) {
    lower <- min(x)
    upper <- max(x)
    sapply(x, function(v) {
      if(abs(v - lower) <= abs(v - upper))
        lower
      else
        upper
    })
  })
)
# Display results
result <- data.frame(
  Original = data,
  Bin_Mean = smoothed_mean,
  Bin_Boundary = smoothed_boundary
)
print(result)
# Histogram
hist(data,
     main = "Histogram of Electronics Prices",
     xlab = "Price",
     ylab = "Frequency",
     breaks = 10)
